---
import Bricks from '@/assets/icons/bricks.svg';
import Cup from '@/assets/icons/cup.svg';
import House from '@/assets/icons/house.svg';
import SectionHeading from '@/components/ui/SectionHeading.astro';

const steps = [
  {
    Icon: Cup,
    title: 'On parle de votre projet, gratuitement.',
    text: 'Vos clients, votre marché, vos objectifs deviennent nos objectifs.',
  },
  {
    Icon: Bricks,
    title: 'On crée le site web ensemble.',
    text: "Moins d'attente, plus de contrôle, zéro compromis sur la qualité.",
  },
  {
    Icon: House,
    title: 'Dès que le site est en ligne, vous avez la main.',
    text: 'Retours illimités sur la modification du contenu du site, et du design une fois le site en ligne.',
  },
];
---

<section class="bg-ink text-cream">
  <div class="container-site pt-20 pb-28 lg:pb-44">
    <SectionHeading
      theme="dark"
      badge="Services"
      title={'Nous construisons avec vous,\npas pour vous'}
      subtitle="Un vrai partenaire qui écoute avant de coder. Nous accélérons grâce à l'IA, mais c'est votre vision qui guide chaque décision."
      subtitleClass="max-w-212"
    />

    <ol class="mx-auto mt-16 grid max-w-330 gap-14 lg:mt-20 lg:grid-cols-3 lg:gap-10">
      {steps.map(({ Icon, title, text }, index) => (
        <li
          data-reveal
          style={{ '--reveal-delay': `${index * 120}ms` }}
          class="flex flex-col items-center text-center"
        >
          <div class="flex h-[45px] items-center text-orange">
            <Icon aria-hidden="true" class="h-auto w-[55px]" />
          </div>
          <h3 class="mt-6 text-[1.625rem] leading-[1.3] font-bold lg:text-[1.875rem]">{title}</h3>
          <p class="mt-6 max-w-[24rem] text-base leading-normal text-pretty">{text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
