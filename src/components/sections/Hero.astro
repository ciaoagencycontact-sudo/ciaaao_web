---
import Sketch from '@/components/deco/Sketch.astro';
import Button from '@/components/ui/Button.astro';
import Logo from '@/components/ui/Logo.astro';
---

<section class="overflow-hidden bg-cream text-ink">
  <div class="container-site">
    <div class="relative pt-32 pb-14 xl:pt-49 xl:pb-17.5" data-sketch-scene>
      <!-- Décorations dessinées à la main, dans le sens horaire autour du titre (positions : maquette 1920px) -->
      <Sketch
        name="smile"
        order={1}
        class="pointer-events-none absolute top-6 left-0 w-16 sm:top-10 sm:w-24 xl:top-[242px] xl:left-[10.1%] xl:w-[136px] h-auto text-orange"
      />
      <Sketch
        name="dot-arrow"
        order={2}
        class="pointer-events-none absolute top-4 right-0 w-20 sm:top-12 sm:w-32 xl:top-[253px] xl:right-auto xl:left-[77.8%] xl:w-[167px] h-auto text-orange"
      />
      <Sketch
        name="exclamation"
        order={4}
        class="pointer-events-none absolute bottom-6 left-2 hidden w-9 sm:block xl:top-[582px] xl:bottom-auto xl:left-[8.8%] xl:w-[63px] h-auto text-orange"
      />
      <Sketch
        name="hashtag"
        order={3}
        class="pointer-events-none absolute right-2 bottom-8 hidden w-16 sm:block xl:top-[632px] xl:right-auto xl:bottom-auto xl:left-[88.3%] xl:w-[101px] h-auto text-orange"
      />

      <div class="relative flex flex-col items-center text-center">
        <h1 class="flex flex-col items-center">
          <span class="sr-only">{'CIAAAO Agency : '}</span>
          <Logo
            markClass="text-orange"
            wordmarkClass="text-black"
            class="[--logo-h:110px] sm:[--logo-h:160px] lg:[--logo-h:200px] xl:[--logo-h:245px]"
          />
          <span class="mt-7 text-[2.125rem] leading-[1.2] font-bold text-balance text-orange sm:text-5xl xl:mt-9 xl:text-[56px]">
            Des sites qui convertissent <br class="max-sm:hidden" />
            et se trouvent
          </span>
        </h1>
        <p class="mt-6 max-w-200 text-lg leading-normal text-pretty lg:text-xl">
          Nous créons des expériences web où le design humain rencontre la puissance de l'IA.{' '}
          <br class="max-lg:hidden" />
          Vos clients trouvent votre site, et votre site les convertit.
        </p>
        <Button variant="compact" href="#offres" class="mt-8">
          Commencer
        </Button>
      </div>
    </div>
  </div>
</section>
