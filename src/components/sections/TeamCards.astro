---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Sketch from '@/components/deco/Sketch.astro';

const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);

// Composition relevée sur la maquette dans un cadre de 1040×600px (positions en %).
const cardPositions = [
  { left: '5.87%', top: '4.5%' },
  { left: '28.75%', top: '16.5%' },
  { left: '51.25%', top: '30%' },
];
---

<!-- Mobile : cartes qui se chevauchent, décalées en escalier -->
<ul class="flex justify-center pb-12 md:hidden">
  {team.map((member, index) => (
    <li
      class="w-[38%] max-w-54 not-first:ml-[-7%]"
      style={{ transform: `translateY(${index * 24}px) rotate(${(index - 1) * 4}deg)` }}
    >
      <Image
        src={member.data.card}
        alt={`${member.data.name}, ${member.data.role}`}
        width={217}
        class="h-auto w-full"
      />
    </li>
  ))}
</ul>

<!-- Tablette et desktop : composition de la maquette (déborde à droite sur grand écran). -->
<!-- Décorations dessinées à la main : le fil qui relie les cartes, puis le hashtag et les points. -->
<div
  class="relative hidden aspect-1040/600 w-full md:block xl:-mt-10 xl:w-[132.7%]"
  data-sketch-scene
>
  <Sketch name="team-line" order={1} class="absolute inset-0 h-full w-full text-ink" />
  <Sketch
    name="hashtag"
    order={2}
    class="pointer-events-none absolute top-[64.17%] left-[2.12%] w-[9.71%] h-auto text-orange"
  />
  <Sketch
    name="dots"
    order={3}
    class="pointer-events-none absolute top-[84.5%] left-[62.02%] w-[12.6%] h-auto text-orange"
  />
  <ul>
    {team.map((member, index) => (
      <li class="absolute w-[20.87%]" style={cardPositions[index]}>
        <Image
          src={member.data.card}
          alt={`${member.data.name}, ${member.data.role}`}
          width={217}
          class="h-auto w-full transition-transform duration-300 ease-out hover:-translate-y-2 hover:-rotate-2"
        />
      </li>
    ))}
  </ul>
</div>
