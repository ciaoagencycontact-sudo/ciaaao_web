---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  image?: ImageMetadata;
  alt?: string;
  /** Classe de ratio, ex. `aspect-650/506`. */
  aspect?: string;
  sizes?: string;
  class?: string;
}

const {
  image,
  alt = '',
  aspect = 'aspect-650/506',
  sizes = '(min-width: 1024px) 50vw, 100vw',
  class: className,
} = Astro.props;
---

{image ? (
  <Image
    src={image}
    alt={alt}
    widths={[480, 720, 960, 1440]}
    sizes={sizes}
    class:list={['w-full rounded-2xl object-cover', aspect, className]}
  />
) : (
  // Visuel à venir : reprend le placeholder de la maquette (gris + bande colorée).
  <div
    class:list={['flex w-full overflow-hidden rounded-2xl', aspect, className]}
    role="img"
    aria-label="Visuel à venir"
  >
    <div class="grid flex-1 place-items-center bg-[#dbdbdb] text-[#bdbdbd]">
      <Icon name="image" class="size-20 lg:size-30" />
    </div>
    <div class="w-[14.6%] bg-orange/25" />
  </div>
)}
