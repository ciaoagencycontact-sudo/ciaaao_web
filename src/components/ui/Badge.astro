---
import type { Theme } from '@/lib/theme';

interface Props {
  theme?: Theme;
  class?: string;
}

const { theme = 'light', class: className } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center rounded-full border px-3 py-1 text-sm leading-5',
    theme === 'light' ? 'border-ink bg-orange/25 text-ink' : 'border-cream bg-orange/30 text-cream',
    className,
  ]}
>
  <slot />
</span>
