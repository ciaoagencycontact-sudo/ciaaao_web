---
import type { Theme } from '@/lib/theme';

interface Props {
  theme?: Theme;
}

const { theme = 'light' } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center rounded-full border bg-red/45 px-3 py-0.5 text-[13px] leading-5',
    theme === 'light' ? 'border-ink text-ink' : 'border-cream text-cream',
  ]}
>
  <slot />
</span>
