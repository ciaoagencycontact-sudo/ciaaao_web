---
import CoffeeButton from '@/components/layout/CoffeeButton.astro';
import Scribble from '@/components/deco/Scribble.astro';
import Sketch from '@/components/deco/Sketch.astro';
import Logo from '@/components/ui/Logo.astro';
import { site } from '@/config/site';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
---

<!-- Conservé d'une page à l'autre (routeur client) : nav, cercles et menu gardent leur état. -->
<header class="sticky top-0 z-50 bg-orange text-cream" transition:persist="header">
  <div class="container-site flex h-18 items-center justify-between gap-6 lg:h-[85px]">
    <a
      href="/"
      class="rounded-sm"
      aria-label={`${site.name}, accueil`}
      data-logo-link
      data-astro-prefetch="load"
    >
      <Logo class="[--logo-h:36px] lg:[--logo-h:40px]" />
    </a>

    <nav aria-label="Navigation principale" class="hidden items-center gap-12 lg:flex">
      <ul class="flex items-center gap-12">
        {site.mainNav.map((link, index) => (
          <li>
            <a
              href={link.href}
              aria-current={isCurrent(link.href) ? 'page' : undefined}
              class="relative inline-block text-xl font-semibold focus-visible:outline-none"
              data-nav-link
              data-astro-prefetch="load"
            >
              {link.label}
              <!-- Cercle au feutre : survol, focus clavier et page active -->
              <Scribble
                variant="circle"
                index={index}
                ratio={2}
                class="pointer-events-none absolute -top-2.5 -left-4 h-[calc(100%+1.25rem)] w-[calc(100%+2rem)] text-ink"
              />
            </a>
          </li>
        ))}
      </ul>
      <CoffeeButton />
    </nav>

    <button
      type="button"
      class="-mr-2 grid size-11 place-items-center rounded-lg lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <span class="sr-only" data-menu-label>
        Ouvrir le menu
      </span>
      <span class="relative size-7">
        <Scribble variant="burger" class="absolute inset-0 size-7" />
        <Scribble variant="close" class="absolute inset-0 size-7" />
      </span>
    </button>
  </div>

  <!-- Menu mobile : panneau plein écran sous la barre -->
  <div
    id="mobile-menu"
    class="fixed inset-x-0 top-18 bottom-0 overflow-y-auto bg-cream text-ink lg:hidden"
    hidden
    data-menu
  >
    <nav
      aria-label="Navigation mobile"
      class="container-site relative flex min-h-full flex-col pt-12 pb-10"
    >
      <Sketch
        name="dot-arrow"
        class="pointer-events-none absolute top-8 right-5 h-auto w-24 text-orange"
      />
      <ul class="flex flex-col items-start gap-4">
        {site.mainNav.map((link, index) => (
          <li data-menu-item>
            <a
              href={link.href}
              aria-current={isCurrent(link.href) ? 'page' : undefined}
              class="relative inline-block px-1 py-2 font-display text-6xl leading-none focus-visible:outline-none"
              data-nav-link
              data-astro-prefetch="load"
            >
              {link.label}
              <Scribble
                variant="circle"
                index={index}
                ratio={3.2}
                class="pointer-events-none absolute -top-2 -left-5 h-[calc(100%+1rem)] w-[calc(100%+2.5rem)] text-orange"
              />
            </a>
          </li>
        ))}
      </ul>
      <div class="mt-auto pt-12" data-menu-item>
        <CoffeeButton variant="primary" steamClass="text-orange" />
      </div>
    </nav>
  </div>
</header>

<script>
  import '@/scripts/menu';
</script>
