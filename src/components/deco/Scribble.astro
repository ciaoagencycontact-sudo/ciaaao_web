---
/**
 * Griffonnage au feutre en vrai trait (cercle autour d'un lien, vapeur du café, burger, croix).
 * Tracés dans scribbles.json ; animés par scripts/motion/modules/nav.ts et scripts/menu.ts.
 * Sans animation (JS absent ou mouvement réduit), l'affichage est géré en CSS (global.css).
 */
import scribbles from './scribbles.json';

interface Props {
  variant: keyof typeof scribbles;
  /** Choix du tracé quand il en existe plusieurs (ex. cercles différents d'un lien à l'autre). */
  index?: number;
  /**
   * Cercle uniquement : rapport largeur / hauteur de la zone entourée.
   * Le tracé est étiré en conséquence pour garder un trait d'épaisseur régulière.
   */
  ratio?: number;
  /** Déjà dessiné (ex. lien de la page active). */
  drawn?: boolean;
  class?: string;
}

const { variant, index = 0, ratio = 2, drawn = false, class: className } = Astro.props;

const { viewBox, width, variants } = scribbles[variant];
const paths = variants[index % variants.length];

// Pour le cercle, on étire les abscisses (tracés dessinés pour un rapport 2:1).
const scaleX = variant === 'circle' ? ratio / 2 : 1;
const scale = (d: string) => {
  let axis = 0;
  return d.replace(/-?\d+(\.\d+)?/g, (n) =>
    String(Math.round((axis++ % 2 === 0 ? Number(n) * scaleX : Number(n)) * 10) / 10),
  );
};
const [vw, vh] = viewBox;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={`0 0 ${vw * scaleX} ${vh}`}
  preserveAspectRatio={variant === 'circle' ? 'none' : undefined}
  fill="none"
  aria-hidden="true"
  class={className}
  data-scribble={variant}
  data-drawn={drawn ? '' : undefined}
>
  {paths.map((d) => (
    <path
      d={scale(d)}
      stroke="currentColor"
      stroke-width={width}
      stroke-linecap="round"
      stroke-linejoin="round"
      data-scribble-path
    />
  ))}
</svg>
