---
import '@/styles/global.css';
import { Font } from 'astro:assets';
import Footer from '@/components/layout/Footer.astro';
import Header from '@/components/layout/Header.astro';
import { site } from '@/config/site';

interface Props {
  /** Titre de la page (sans le nom du site). */
  title?: string;
  description?: string;
  /** Chemin d'une image Open Graph dans /public. */
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  image = '/og-default.png',
  noindex = false,
} = Astro.props;

const pageTitle = title
  ? `${title} | ${site.name}`
  : `${site.name} | Des sites qui convertissent et se trouvent`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: Astro.site?.href,
  logo: new URL('/favicon.svg', Astro.site).href,
  sameAs: Object.values(site.socials),
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Masque les éléments animés avant le premier rendu (évite un flash),
      // puis les réaffiche si les animations ne se lancent pas dans les 4 secondes.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const root = document.documentElement;
        root.classList.add('motion');
        try {
          if (!sessionStorage.getItem('ciaaao:logo-intro')) root.classList.add('logo-intro');
        } catch {
          /* stockage indisponible : pas d'intro du logo */
        }
        // Arrivée par une transition de page (scripts/motion/modules/transition.ts) :
        // la page démarre couverte, puis se découvre.
        try {
          const raw = sessionStorage.getItem('ciaaao:page-cover');
          sessionStorage.removeItem('ciaaao:page-cover');
          const cover = raw && JSON.parse(raw);
          const here = location.pathname.replace(/\/$/, '') || '/';
          const type = performance.getEntriesByType('navigation')[0]?.type;
          if (cover && cover.to === here && type === 'navigate' && Date.now() - cover.at < 5000) {
            root.classList.add('page-cover');
            root.dataset.coverDirection = cover.direction;
          }
        } catch {
          /* stockage indisponible : pas de transition */
        }
        setTimeout(() => {
          if (!('motionReady' in root.dataset))
            root.classList.remove('motion', 'logo-intro', 'page-cover');
        }, 4000);
      }
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f25922" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-dm-sans" preload />
    <Font cssVariable="--font-bitronik" preload />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(organization)}></script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <!--
      Transition entre les pages : calque colorié au feutre, sous le header.
      En tête du <body> : la page s'affiche au fur et à mesure qu'elle arrive, le calque doit
      être là dès les premiers éléments (sinon le fond sombre apparaît un instant).
    -->
    <div
      class="pointer-events-none invisible fixed inset-x-0 top-18 bottom-0 z-55 text-orange lg:top-[85px]"
      aria-hidden="true"
      data-page-cover
    >
      <svg class="size-full" fill="none" preserveAspectRatio="none">
        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </div>
    <a
      href="#contenu"
      class="sr-only z-60 rounded-lg bg-cream px-4 py-2 font-semibold text-ink focus:not-sr-only focus:fixed focus:top-4 focus:left-4"
    >
      Aller au contenu
    </a>
    <Header />
    <main id="contenu" class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      import '@/scripts/motion/index';
    </script>
  </body>
</html>
